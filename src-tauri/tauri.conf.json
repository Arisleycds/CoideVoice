{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DSedit",
  "version": "0.1.0",
  "identifier": "com.dsedit.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run vite:dev",
    "beforeBuildCommand": "npm run vite:build"
  },
  "app": {
    "windows": [
      {
        "title": "DSedit",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,msWebView2BrowserHitTransparent --enable-features=msWebView2EnableWebSpeechAPI,msEdgeSpeechRecognition --enable-speech-input"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
